# ── Telegram API credentials (from https://my.telegram.org/apps) ─────────────
API_ID=123456
API_HASH=your_api_hash_here

# ── Bot token (from @BotFather) ───────────────────────────────────────────────
BOT_TOKEN=123456:ABC-your_bot_token_here

# ── Local Bot API server URL (enables >50 MB file transfers) ──────────────────
# Run: https://github.com/tdlib/telegram-bot-api
LOCAL_API_URL=http://localhost:8081

# ── Your Telegram numeric user ID (bot ignores everyone else) ─────────────────
ADMIN_USER_ID=987654321
